{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panestra",
  "version": "0.1.8",
  "identifier": "dev.panestra.app",
  "build": {
    "frontendDist": "../../core/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Panestra / 星序",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https: wss:; font-src 'self'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "externalBin": ["binaries/panestra-core", "binaries/system-plugin"],
    "resources": {
      "../../plugins/system/manifest.json": "plugins/system/manifest.json"
    },
    "shortDescription": "one core, every device."
  }
}

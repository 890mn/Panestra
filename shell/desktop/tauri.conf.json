{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panestra",
  "version": "0.1.11",
  "identifier": "dev.panestra.app",
  "build": {
    "frontendDist": "../../core/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Panestra",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https: wss:; font-src 'self'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "externalBin": ["binaries/panestra-core", "binaries/system-plugin"],
    "resources": {
      "../../plugins/system/manifest.json": "plugins/system/manifest.json"
    },
    "shortDescription": "ONE CORE, EVERY DEVICE.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QzRCNDAxMzU3MDkzNTYKUldSV2szQTFBYlRFSmZiM3VrYmdmak9jVHhNb0xzNlpZQzRnS3FLeEhqd3ZyZ0QwRGRUd05JbjMK",
      "endpoints": ["https://github.com/890mn/Panestra/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}

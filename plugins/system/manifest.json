{
  "schemaVersion": 1,
  "id": "dev.panestra.system",
  "name": "System Monitor",
  "version": "0.1.0",
  "engine": {
    "pluginApi": ">=1.0.0 <2.0.0",
    "runtime": "native-process",
    "entry": "system-plugin.exe"
  },
  "permissions": [
    {
      "id": "system.metrics.read",
      "required": true
    },
    {
      "id": "system.session.lock",
      "required": false
    }
  ],
  "sources": [
    {
      "id": "cpu.usage",
      "type": "number",
      "unit": "%",
      "defaultIntervalMs": 1000
    },
    {
      "id": "memory.usage",
      "type": "number",
      "unit": "%",
      "defaultIntervalMs": 1000
    },
    {
      "id": "disk.usage",
      "type": "number",
      "unit": "%",
      "defaultIntervalMs": 1000
    },
    {
      "id": "network.rx",
      "type": "number",
      "unit": "KB/s",
      "defaultIntervalMs": 1000
    },
    {
      "id": "network.tx",
      "type": "number",
      "unit": "KB/s",
      "defaultIntervalMs": 1000
    },
    {
      "id": "system.info",
      "type": "object",
      "unit": "",
      "defaultIntervalMs": 1000
    }
  ],
  "widgets": [
    {
      "id": "metric-card",
      "renderer": "declarative",
      "subscriptions": ["cpu.usage", "memory.usage", "disk.usage"],
      "layout": {
        "desktop": {
          "minW": 2,
          "minH": 2,
          "maxW": 12,
          "maxH": 12
        },
        "tablet": {
          "minW": 2,
          "minH": 2,
          "maxW": 8,
          "maxH": 12
        },
        "mobile": {
          "minW": 2,
          "minH": 2,
          "maxW": 4,
          "maxH": 12
        }
      },
      "sizePresets": [
        {
          "id": "mini",
          "w": 2,
          "h": 2
        },
        {
          "id": "strip",
          "w": 4,
          "h": 2
        },
        {
          "id": "standard",
          "w": 4,
          "h": 3
        },
        {
          "id": "detail",
          "w": 4,
          "h": 4
        },
        {
          "id": "wide",
          "w": 6,
          "h": 3
        },
        {
          "id": "large",
          "w": 8,
          "h": 4
        }
      ],
      "presentations": ["auto", "value", "trend", "gauge", "dial", "segments", "bars"]
    },
    {
      "id": "network-chart",
      "renderer": "declarative",
      "subscriptions": ["network.rx", "network.tx"],
      "layout": {
        "desktop": {
          "minW": 2,
          "minH": 2,
          "maxW": 12,
          "maxH": 12
        },
        "tablet": {
          "minW": 2,
          "minH": 2,
          "maxW": 8,
          "maxH": 12
        },
        "mobile": {
          "minW": 2,
          "minH": 2,
          "maxW": 4,
          "maxH": 12
        }
      },
      "sizePresets": [
        {
          "id": "mini",
          "w": 2,
          "h": 2
        },
        {
          "id": "strip",
          "w": 4,
          "h": 2
        },
        {
          "id": "standard",
          "w": 4,
          "h": 3
        },
        {
          "id": "detail",
          "w": 4,
          "h": 4
        },
        {
          "id": "wide",
          "w": 6,
          "h": 3
        },
        {
          "id": "large",
          "w": 8,
          "h": 4
        }
      ],
      "presentations": ["auto", "rates", "trend", "split", "bars", "meters"]
    },
    {
      "id": "system-overview",
      "renderer": "declarative",
      "subscriptions": ["system.info"],
      "layout": {
        "desktop": {
          "minW": 2,
          "minH": 2,
          "maxW": 12,
          "maxH": 12
        },
        "tablet": {
          "minW": 2,
          "minH": 2,
          "maxW": 8,
          "maxH": 12
        },
        "mobile": {
          "minW": 2,
          "minH": 2,
          "maxW": 4,
          "maxH": 12
        }
      },
      "sizePresets": [
        {
          "id": "mini",
          "w": 2,
          "h": 2
        },
        {
          "id": "strip",
          "w": 4,
          "h": 2
        },
        {
          "id": "standard",
          "w": 4,
          "h": 3
        },
        {
          "id": "detail",
          "w": 4,
          "h": 4
        },
        {
          "id": "wide",
          "w": 6,
          "h": 3
        },
        {
          "id": "large",
          "w": 8,
          "h": 4
        }
      ],
      "presentations": ["auto", "summary", "details", "tiles"]
    }
  ],
  "actions": [
    {
      "id": "lock",
      "permission": "system.session.lock",
      "risk": "medium"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "sampleIntervalMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 1000
      }
    }
  }
}
